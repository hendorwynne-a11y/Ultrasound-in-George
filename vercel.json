.trust-card h3{margin:0 0 8px;font-size:18px}.trust-card p{margin:0;color:#52677d;line-height:1.45}
.services{padding:58px 0 38px;text-align:center}.services small{color:#0787b9;font-weight:900;text-transform:uppercase;letter-spacing:.5px}
.services h2{font-size:40px;line-height:1.1;margin:10px 0 32px}
.service-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:18px}
.service{background:#fff;border-radius:18px;padding:24px 10px;font-weight:900;box-shadow:0 8px 20px rgba(0,0,0,.08)}
.service div{font-size:34px;margin-bottom:10px}
.booking{margin-top:36px;background:linear-gradient(90deg,#062b55,#0086a8);color:#fff;border-radius:22px;padding:32px;display:flex;justify-content:space-between;align-items:center;gap:20px;text-align:left}
.booking h2{margin:0 0 8px;font-size:32px}.booking p{margin:0;color:#dff8ff}.booking .btn{background:#fff;color:#061b3a;min-width:220px;box-shadow:none}
footer{background:#061b3a;color:#fff;padding:42px 16px 18px}
.footer-grid{max-width:1180px;margin:auto;display:grid;grid-template-columns:1fr 1fr 1fr 1.4fr;gap:30px}
footer h4{margin:0 0 14px;color:#75d8ee;text-transform:uppercase}footer p,footer li{color:#e8f5fb;line-height:1.6}
ul{list-style:none;padding:0;margin:0}.copy{max-width:1180px;margin:28px auto 0;padding-top:18px;border-top:1px solid rgba(255,255,255,.2);text-align:center;color:#cce7f0}
@media(max-width:768px){
  .topbar{font-size:12.5px;padding:8px 10px}.topbar-inner{display:grid;grid-template-columns:1fr;gap:5px;text-align:center}
  .mobile-actions{display:grid}
  .trust{width:calc(100% - 24px);margin-top:16px;grid-template-columns:1fr;border-radius:20px}
  .trust-card{border-right:none;border-bottom:1px solid #dbeaf3;padding:24px 18px}.trust-card:last-child{border-bottom:none}
  .services{padding:42px 0 28px}.services h2{font-size:29px}
  .service-grid{grid-template-columns:1fr 1fr;gap:12px}.service{padding:20px 8px;font-size:14px}
  .booking{flex-direction:column;text-align:center;padding:26px 18px}.booking h2{font-size:27px}.booking .btn{width:100%}
  .footer-grid{grid-template-columns:1fr}
}
@media(max-width:430px){.wrap{width:calc(100% - 24px)}.service-grid{grid-template-columns:1fr}}
